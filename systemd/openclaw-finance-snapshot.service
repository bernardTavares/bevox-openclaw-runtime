[Unit]
Description=E11 wave 1 finance snapshot builder (oneshot)
Documentation=file://%h/bevox-knowledge/35_specs/2026-04-14-e11-finance-runway-wave-1.md
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.openclaw/health/health-venv/bin/python3 %h/.openclaw/finance/runner.py --build
WorkingDirectory=%h/.openclaw/finance
Environment=USAGE_DB_PATH=%h/.openclaw/cost/usage-tracking.db
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
