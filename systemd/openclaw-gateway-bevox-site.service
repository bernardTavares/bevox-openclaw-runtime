[Unit]
Description=OpenClaw Gateway (profile: bevox-site, v2026.4.8)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-%h/.openclaw/gateway/bots/bevox-site.env
ExecStart=/usr/bin/node %h/.npm-global/lib/node_modules/openclaw/dist/index.js gateway --port 18792
Restart=always
RestartSec=5
TimeoutStopSec=30
TimeoutStartSec=30
SuccessExitStatus=0 143
KillMode=control-group
Environment=HOME=%h
Environment=TMPDIR=/tmp
Environment=OPENCLAW_STATE_DIR=%h/.openclaw-bevox-site
Environment=OPENCLAW_CONFIG_PATH=%h/.openclaw-bevox-site/openclaw.json
Environment=PATH=/usr/bin:%h/.local/bin:%h/.npm-global/bin:%h/bin:%h/.volta/bin:%h/.asdf/shims:%h/.bun/bin:%h/.nvm/current/bin:%h/.fnm/current/bin:%h/.local/share/pnpm:/usr/local/bin:/bin
Environment=OPENCLAW_PROFILE=bevox-site
Environment=OPENCLAW_GATEWAY_PORT=18792
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway-bevox-site.service
Environment="OPENCLAW_WINDOWS_TASK_NAME=OpenClaw Gateway (bevox-site)"
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
Environment=OPENCLAW_SERVICE_VERSION=2026.4.8

[Install]
WantedBy=default.target
