[Unit]
Description=OpenClaw Gateway (profile: knowledge, v2026.4.8)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/share/fnm/node-versions/v22.22.2/installation/bin/node %h/.npm-global/lib/node_modules/openclaw/dist/index.js gateway --port 18797
Restart=always
RestartSec=5
TimeoutStopSec=30
TimeoutStartSec=30
SuccessExitStatus=0 143
KillMode=control-group
Environment=HOME=%h
Environment=TMPDIR=/tmp
Environment=OPENCLAW_STATE_DIR=%h/.openclaw-knowledge
Environment=OPENCLAW_CONFIG_PATH=%h/.openclaw-knowledge/openclaw.json
Environment=PATH=%h/.local/share/fnm/node-versions/v22.22.2/installation/bin:%h/.local/share/pnpm:%h/.local/share/fnm/current/bin:%h/.local/bin:%h/.npm-global/bin:%h/bin:%h/.volta/bin:%h/.asdf/shims:%h/.bun/bin:%h/.nvm/current/bin:%h/.fnm/current/bin:/usr/local/bin:/usr/bin:/bin
Environment=OPENCLAW_PROFILE=knowledge
Environment=OPENCLAW_GATEWAY_OPERATOR_IDS=<your-telegram-user-id>
Environment=OPENCLAW_GATEWAY_PORT=18797
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway-knowledge.service
Environment="OPENCLAW_WINDOWS_TASK_NAME=OpenClaw Gateway (knowledge)"
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
Environment=OPENCLAW_SERVICE_VERSION=2026.4.8

[Install]
WantedBy=default.target
