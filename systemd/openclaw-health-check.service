[Unit]
Description=E8 wave 1 health check runner (oneshot scan)
Documentation=file://%h/bevox-knowledge/35_specs/2026-04-14-e8-infra-health-backup-wave-1.md

[Service]
Type=oneshot
ExecStart=%h/.openclaw/health/health-venv/bin/python3 %h/.openclaw/health/runner.py --scan
WorkingDirectory=%h/.openclaw/health
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
